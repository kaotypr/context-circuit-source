.DS_Store
/repositories/
/.worktrees/
/repositories.local.yaml
/member.local.yaml
/.context-circuit/local/
/.context-circuit/role-tiering.local.yaml
/.context-circuit/bin/
# Role definitions, regenerated by `agent setup`. Their model and effort come
# from this machine's role-tiering overrides, so committing them would publish
# one member's settings as everyone's. The skills beside them are not ignored.
/.codex/agents/cc-*.toml
/.claude/agents/cc-*.md
/.cursor/agents/cc-*.md
# Host settings `agent setup` merges into this machine's local file, such as
# turning off Claude Code's commit attribution. The file holds a person's own
# settings too, so it stays on this machine.
/.claude/settings.local.json
