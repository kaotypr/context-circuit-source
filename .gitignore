.DS_Store
.runtime/
dist/

# Repository bindings and checkout contents are host-local and never shipped.
# Anchored to the workspace root and the template seed ONLY — a bare `repositories/`
# also matched test/repositories/ and left that acceptance suite untracked.
/repositories/
/repositories.local.yaml
/template/repositories/
/template/repositories.local.yaml

# Per-user, host-local role tiering (model/effort). Preferences differ per person
# and per host, so it is never shipped and never portable (role-tiering.md).
# Gitignore is not a read block: coordinators MUST still Read this file from the
# workspace root before spawning a worker, verifier, or tracer. A search that
# skips ignored files is not "file absent" — open the path directly.
/role-tiering.local.yaml
/template/role-tiering.local.yaml

# Disposable output from the human-simulated agent test harness.
/agent-harness/human/.out/
/agent-harness/human/.live.log
# Local, this-machine-only opt-in to run the coordinator UNSANDBOXED (never shipped).
/agent-harness/human/drivers/.allow-unsandboxed
# Tool-generated local graph cache; never project material.
.code-review-graph/
