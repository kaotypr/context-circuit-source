{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaotypr.dev/kao-delivery-workspace/work-candidate.schema.json",
  "title": "Read-only work candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "candidate_id", "kind", "work_id", "title", "state", "urgent", "priority", "owner", "plan_reference", "plan_approval_state", "dependencies", "scope_sufficient", "acceptance_sufficient", "repositories", "access_available", "contract_blocked", "source_reference", "risks"],
  "properties": {
    "contract_version": { "const": 1 },
    "candidate_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$" },
    "kind": { "enum": ["assigned-work", "review", "verification-failure", "ci-failure", "activity-task", "repository-item", "contribution-follow-up", "plan-work-item"] },
    "work_id": { "type": ["string", "null"], "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "state": { "enum": ["ready", "in-progress", "review", "failed", "completed", "cancelled"] },
    "urgent": { "type": "boolean" },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "owner": { "type": ["string", "null"], "minLength": 1 },
    "plan_reference": { "type": ["string", "null"], "minLength": 1 },
    "plan_approval_state": { "enum": ["approved", "draft", "not-applicable", "unknown"] },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "state"],
        "properties": {
          "reference": { "type": "string", "minLength": 1 },
          "state": { "enum": ["completed", "pending", "unknown"] }
        }
      }
    },
    "scope_sufficient": { "type": "boolean" },
    "acceptance_sufficient": { "type": "boolean" },
    "repositories": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "access_available": { "type": "boolean" },
    "contract_blocked": { "type": "boolean" },
    "source_reference": { "type": "string", "minLength": 1 },
    "risks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
