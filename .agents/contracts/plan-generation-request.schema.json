{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/plan-generation-request.schema.json",
  "title": "Atomic plan generation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "source", "plans"],
  "properties": {
    "contract_version": { "const": 2 },
    "source": { "$ref": "#/$defs/source" },
    "plans": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/plan" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": { "enum": ["idea", "prd", "document", "issue", "pull-request"] },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "stringList": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "nonEmptyStringList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": { "enum": ["depends-on", "integrates-with", "blocks", "related", "supersedes"] },
        "target": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "area", "repository", "scope", "test_scope", "test_policy", "verification_commands", "acceptance_criteria"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "work_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}-[0-9]{3,}$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "area": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "test_scope": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "test_policy": { "enum": ["required", "existing-coverage", "verifier-only", "not-required"] },
        "test_rationale": { "type": "string", "minLength": 1 },
        "verification_commands": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "acceptance_criteria": { "$ref": "#/$defs/nonEmptyStringList" },
        "parent": { "type": "string", "minLength": 1 },
        "subtasks": { "$ref": "#/$defs/stringList" },
        "depends_on": { "$ref": "#/$defs/stringList" },
        "connections": { "type": "array", "items": { "$ref": "#/$defs/connection" } }
      },
      "allOf": [{
        "if": { "properties": { "test_policy": { "enum": ["required", "existing-coverage"] } }, "required": ["test_policy"] },
        "then": { "properties": { "test_scope": { "minItems": 1 } } }
      }]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "title", "repository", "work_prefix", "summary", "assumptions", "open_questions", "requirements", "solution", "delivery", "verification", "risks", "work_items"],
      "properties": {
        "plan_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "repository_collection": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-plans$" },
        "track": { "enum": ["epic", "bau"] },
        "plan_number": { "type": "integer", "minimum": 1 },
        "slug": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "source": { "$ref": "#/$defs/source" },
        "work_prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}$" },
        "summary": { "type": "string", "minLength": 1 },
        "affected_repositories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
        "assumptions": { "$ref": "#/$defs/stringList" },
        "open_questions": { "$ref": "#/$defs/stringList" },
        "requirements": { "$ref": "#/$defs/nonEmptyStringList" },
        "solution": { "$ref": "#/$defs/nonEmptyStringList" },
        "delivery": { "$ref": "#/$defs/nonEmptyStringList" },
        "verification": { "$ref": "#/$defs/nonEmptyStringList" },
        "risks": { "$ref": "#/$defs/stringList" },
        "work_items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/task" } },
        "depends_on_plans": { "$ref": "#/$defs/stringList" },
        "connections": { "type": "array", "items": { "$ref": "#/$defs/connection" } },
        "product_knowledge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["impact", "references"],
          "properties": {
            "impact": { "enum": ["none", "documentation-correction", "implementation-only", "behavior-change", "new-workflow", "retired-workflow"] },
            "references": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.md$" } },
            "proposed_change": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
