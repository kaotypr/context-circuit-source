{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/verifier-result.schema.json",
  "title": "Independent verifier result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "repository", "status", "summary", "acceptance", "checks", "findings", "verified_at"],
  "properties": {
    "contract_version": { "enum": [1, 2] },
    "work_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "plan_reference": { "type": "string", "minLength": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "plan_version": { "type": "integer", "minimum": 1 },
    "task_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}-[0-9]{3,}$" },
    "plan_revision": { "type": "integer", "minimum": 1 },
    "approved_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "attempt": { "type": "integer", "minimum": 0 },
    "repository": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "worktree": { "type": "string", "minLength": 1 },
    "start_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "status": { "enum": ["pass", "fail", "blocked"] },
    "summary": { "type": "string", "minLength": 1 },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed", "blocked"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "description", "evidence"],
        "properties": {
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "description": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verified_at": { "type": "string", "format": "date-time" },
    "product_knowledge_impact": { "enum": ["absent", "matches-declared", "broader-than-declared", "contradicts-current"] }
  },
  "allOf": [
    { "if": { "properties": { "contract_version": { "const": 1 } }, "required": ["contract_version"] }, "then": { "required": ["work_id", "run_id"] } },
    { "if": { "properties": { "contract_version": { "const": 2 } }, "required": ["contract_version"] }, "then": { "required": ["run_id", "plan_reference", "plan_id", "plan_version", "task_id", "plan_revision", "approved_digest", "attempt", "repository", "branch", "worktree", "start_commit"] } }
  ]
}
