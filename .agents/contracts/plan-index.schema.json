{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaotypr.dev/kao-delivery-workspace/plan-index.schema.json",
  "title": "Plan README index metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "plan_id", "title", "status", "plan_version", "approved_at", "approved_by", "revision_reason", "source", "work_prefix", "documents", "work_breakdown", "material_digest", "approved_digest", "created_at", "updated_at"],
  "properties": {
    "contract_version": { "const": 1 },
    "plan_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "approved"] },
    "plan_version": { "type": "integer", "minimum": 1 },
    "approved_at": { "type": ["string", "null"], "format": "date-time" },
    "approved_by": { "type": ["string", "null"], "minLength": 1 },
    "revision_reason": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": { "enum": ["idea", "prd", "document", "issue", "pull-request"] },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "work_prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}$" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*\\.md$" }
    },
    "work_breakdown": { "type": "string", "pattern": "^[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*\\.md$" },
    "material_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "approved_digest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "approved" } }, "required": ["status"] },
      "then": {
        "properties": {
          "approved_at": { "type": "string", "format": "date-time" },
          "approved_by": { "type": "string", "minLength": 1 },
          "approved_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      },
      "else": {
        "properties": {
          "approved_at": { "type": "null" },
          "approved_by": { "type": "null" },
          "approved_digest": { "type": "null" }
        }
      }
    }
  ]
}
