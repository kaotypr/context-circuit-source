{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/plan-index.schema.json",
  "title": "Plan README index metadata",
  "oneOf": [
    { "$ref": "#/$defs/legacy" },
    { "$ref": "#/$defs/rootPlan" }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": { "enum": ["idea", "prd", "document", "issue", "pull-request"] },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "productKnowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impact", "references"],
      "properties": {
        "impact": { "enum": ["none", "documentation-correction", "implementation-only", "behavior-change", "new-workflow", "retired-workflow"] },
        "references": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.md$" } },
        "proposed_change": { "type": "string", "minLength": 1 }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": { "enum": ["depends-on", "integrates-with", "blocks", "related", "supersedes"] },
        "target": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "plan_id", "title", "status", "plan_version", "approved_at", "approved_by", "revision_reason", "source", "work_prefix", "documents", "work_breakdown", "material_digest", "approved_digest", "created_at", "updated_at"],
      "properties": {
        "contract_version": { "const": 1 },
        "plan_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "approved"] },
        "plan_version": { "type": "integer", "minimum": 1 },
        "approved_at": { "type": ["string", "null"], "format": "date-time" },
        "approved_by": { "type": ["string", "null"], "minLength": 1 },
        "revision_reason": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "work_prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}$" },
        "documents": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*\\.md$" } },
        "work_breakdown": { "type": "string", "pattern": "^[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*\\.md$" },
        "material_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "approved_digest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "product_knowledge": { "$ref": "#/$defs/productKnowledge" }
      },
      "allOf": [{
        "if": { "properties": { "status": { "const": "approved" } }, "required": ["status"] },
        "then": { "properties": { "approved_at": { "type": "string", "format": "date-time" }, "approved_by": { "type": "string", "minLength": 1 }, "approved_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } } },
        "else": { "properties": { "approved_at": { "type": "null" }, "approved_by": { "type": "null" }, "approved_digest": { "type": "null" } } }
      }]
    },
    "rootPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "plan_id", "title", "repository_collection", "track", "plan_number", "plan_reference", "status", "status_updated_at", "status_reason", "status_actor", "status_evidence", "archived_at", "plan_version", "approved_at", "approved_by", "revision_reason", "source", "source_reference", "work_prefix", "documents", "work_breakdown", "task_index", "material_digest", "approved_digest", "affected_repositories", "depends_on_plans", "connections", "created_at", "updated_at"],
      "properties": {
        "contract_version": { "const": 2 },
        "plan_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "repository_collection": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-plans$" },
        "track": { "enum": ["epic", "bau"] },
        "plan_number": { "type": "integer", "minimum": 1 },
        "plan_reference": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "approved", "in-progress", "blocked", "review-ready", "merge-pending", "completed", "archived"] },
        "status_updated_at": { "type": "string", "format": "date-time" },
        "status_reason": { "type": "string", "minLength": 1 },
        "status_actor": { "type": "string", "minLength": 1 },
        "status_evidence": { "type": ["string", "null"], "minLength": 1 },
        "archived_at": { "type": ["string", "null"], "format": "date-time" },
        "plan_version": { "type": "integer", "minimum": 1 },
        "approved_at": { "type": ["string", "null"], "format": "date-time" },
        "approved_by": { "type": ["string", "null"], "minLength": 1 },
        "revision_reason": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "source_reference": { "type": "string", "minLength": 1 },
        "work_prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}$" },
        "documents": { "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:overview|requirements|acceptance-criteria|solution|delivery|verification|risks)\\.md$" } },
        "work_breakdown": { "const": "tasks/README.md" },
        "task_index": { "const": "tasks/README.md" },
        "material_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "approved_digest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "affected_repositories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
        "depends_on_plans": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "connections": { "type": "array", "items": { "$ref": "#/$defs/connection" } },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "product_knowledge": { "$ref": "#/$defs/productKnowledge" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "approved" } }, "required": ["status"] },
          "then": { "properties": { "approved_at": { "type": "string", "format": "date-time" }, "approved_by": { "type": "string", "minLength": 1 }, "approved_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } } }
        },
        {
          "if": { "properties": { "status": { "const": "draft" } }, "required": ["status"] },
          "then": { "properties": { "approved_at": { "type": "null" }, "approved_by": { "type": "null" }, "approved_digest": { "type": "null" } } }
        }
      ]
    }
  }
}
