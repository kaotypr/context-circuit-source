{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/product-knowledge-candidate.schema.json",
  "title": "Product Knowledge discovery result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "generated_at", "topic", "revision", "resolved_context", "findings"],
  "properties": {
    "contract_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "topic": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "resolved_context": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["classification", "topic", "summary", "target", "sources"],
        "properties": {
          "classification": { "enum": ["candidate", "contradiction", "gap"] },
          "topic": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "target": { "type": ["string", "null"], "minLength": 1 },
          "sources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  },
  "$defs": {
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" }
  }
}
