{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/product-knowledge-sync-record.schema.json",
  "title": "Effective Product Knowledge synchronization record",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "synced_at", "confirming_role", "updated_pages", "source_contributions"],
  "properties": {
    "contract_version": { "const": 1 },
    "synced_at": { "type": "string", "format": "date-time" },
    "confirming_role": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "updated_pages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.md$" } },
    "source_contributions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
