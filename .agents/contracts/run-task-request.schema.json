{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/run-task-request.schema.json",
  "title": "Structured run-task request",
  "oneOf": [
    { "$ref": "#/$defs/contractFirstRequest" },
    { "$ref": "#/$defs/planRequest" }
  ],
  "$defs": {
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "depends_on", "scope", "test_scope", "test_policy", "verification_commands", "acceptance_criteria"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
        "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "test_scope": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "test_policy": { "enum": ["required", "existing-coverage", "verifier-only", "not-required"] },
        "test_rationale": { "type": "string", "minLength": 1 },
        "verification_commands": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "contractFirstRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "request", "acceptance_criteria", "shared_contract", "repositories"],
      "properties": {
        "contract_version": { "const": 1 },
        "request": { "type": "string", "minLength": 1 },
        "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "shared_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "paths"],
          "properties": {
            "repository": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } }
          }
        },
        "repositories": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/repository" } }
      }
    },
    "planRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "source", "request", "work_ids", "dependency_evidence", "acceptance_criteria", "repositories"],
      "properties": {
        "contract_version": { "const": 1 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference", "plan_version", "approved_digest"],
          "properties": {
            "kind": { "const": "plan" },
            "reference": { "$ref": "#/$defs/path" },
            "plan_version": { "type": "integer", "minimum": 1 },
            "approved_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "request": { "type": "string", "minLength": 1 },
        "work_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}-[0-9]{3,}$" } },
        "dependency_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["work_id", "evidence"],
            "properties": {
              "work_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}-[0-9]{3,}$" },
              "evidence": { "type": "string", "minLength": 1 }
            }
          }
        },
        "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "repositories": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/repository" } }
      }
    }
  }
}
