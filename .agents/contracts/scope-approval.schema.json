{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/scope-approval.schema.json",
  "title": "Task-level scope expansion approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "scope_approval_id", "work_id", "run_id", "task_id", "repository", "mode", "reason", "approved_by", "approved_at"],
  "properties": {
    "contract_version": { "const": 1 },
    "scope_approval_id": { "type": "string", "minLength": 1 },
    "work_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "mode": { "const": "task-level-expansion" },
    "reason": { "type": "string", "minLength": 1 },
    "approved_by": { "type": "string", "minLength": 1 },
    "approved_at": { "type": "string", "format": "date-time" }
  }
}
