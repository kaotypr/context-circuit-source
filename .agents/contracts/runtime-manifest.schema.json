{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/runtime-manifest.schema.json",
  "title": "Run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "work_id", "run_id", "source_kind", "status", "created_at", "updated_at", "task_brief", "repositories", "evidence", "warnings", "lifecycle_events"],
  "properties": {
    "contract_version": { "enum": [1, 2, 3] },
    "work_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "source_kind": { "enum": ["direct-request", "plan", "issue", "pull-request", "activity-task"] },
    "status": { "enum": ["preparing", "prepared", "running", "verifying", "passed", "failed", "blocked", "cancelled", "closing", "closed"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "task_brief": { "type": "string", "minLength": 1 },
    "plan_reference": { "type": "string", "minLength": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "plan_version": { "type": "integer", "minimum": 1 },
    "approved_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "base_path", "base_commit", "branch", "worktree", "worker_input", "verifier_input"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "base_path": { "type": "string", "minLength": 1 },
          "base_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
          "branch": { "type": "string", "minLength": 1 },
          "worktree": { "type": "string", "minLength": 1 },
          "worker_input": { "type": "string", "minLength": 1 },
          "verifier_input": { "type": "string", "minLength": 1 },
          "task_inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "verifier_inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "active_task_id": { "type": "string", "minLength": 1 },
          "lock_path": { "type": "string", "minLength": 1 },
          "status": { "enum": ["waiting", "prepared", "running", "verifying", "passed", "failed", "blocked", "cancelled", "closing", "closed"] },
          "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
          "repair_attempts": { "type": "integer", "minimum": 0 },
          "review_preparation": { "type": "string", "minLength": 1 },
          "review_publication": { "type": "string", "minLength": 1 },
          "review_state": { "enum": ["ready-for-local-review", "ready-for-publication", "published-for-review", "merge-confirmation-required", "closeout-ready"] },
          "merge_confirmation": { "type": "string", "minLength": 1 },
          "closeout_record": { "type": "string", "minLength": 1 },
          "contribution": { "type": "string", "minLength": 1 }
        }
      }
    },
    "plan_work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_id", "repository", "depends_on", "outcome"],
        "properties": {
          "work_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}-[0-9]{3,}$" },
          "repository": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "outcome": { "enum": ["pending", "passed", "failed", "blocked", "cancelled"] },
          "task_input": { "type": "string", "minLength": 1 },
          "verifier_input": { "type": "string", "minLength": 1 },
          "plan_reference": { "type": "string", "minLength": 1 },
          "task_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}-[0-9]{3,}$" },
          "plan_revision": { "type": "integer", "minimum": 1 },
          "attempt": { "type": "integer", "minimum": 0 },
          "start_commit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$" },
          "ready": { "type": "boolean" },
          "blocked_by": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "status": { "enum": ["waiting", "prepared", "running", "verifying", "passed", "failed", "blocked"] },
          "worker_result": { "type": "string", "minLength": 1 },
          "verifier_result": { "type": "string", "minLength": 1 }
        }
      }
    },
    "task_graph": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_id", "repository", "depends_on", "outcome", "worker_input", "verifier_input"],
        "properties": {
          "work_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}-[0-9]{3,}$" },
          "repository": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "outcome": { "enum": ["pending", "passed", "failed", "blocked", "cancelled"] },
          "worker_input": { "type": "string", "minLength": 1 },
          "verifier_input": { "type": "string", "minLength": 1 },
          "plan_reference": { "type": "string", "minLength": 1 },
          "task_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}-[0-9]{3,}$" },
          "plan_revision": { "type": "integer", "minimum": 1 },
          "attempt": { "type": "integer", "minimum": 0 },
          "start_commit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$" },
          "ready": { "type": "boolean" },
          "blocked_by": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "status": { "enum": ["waiting", "prepared", "running", "verifying", "passed", "failed", "blocked"] },
          "worker_result": { "type": "string", "minLength": 1 },
          "verifier_result": { "type": "string", "minLength": 1 }
        }
      }
    },
    "plan_revision": { "type": "integer", "minimum": 1 },
    "plan_verifier_input": { "type": "string", "minLength": 1 },
    "plan_verifier_result": { "type": "string", "minLength": 1 },
    "plan_verifier_status": { "enum": ["pending", "running", "passed", "failed", "blocked"] },
    "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "execution_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "repository", "from_status", "to_status", "inferred", "idempotency_key", "occurred_at"],
        "properties": {
        "stage": { "enum": ["worker-started", "worker-result", "verifier-result", "plan-verifier-result", "repair-prepared", "repair-exhausted", "review-prepared", "closeout-prepared", "closeout-cleaned"] },
          "repository": { "type": "string", "minLength": 1 },
          "from_status": { "enum": ["prepared", "running", "verifying", "passed", "failed", "blocked", "cancelled", "closing"] },
          "to_status": { "enum": ["running", "verifying", "passed", "failed", "blocked", "closing", "closed"] },
          "inferred": { "type": "boolean" },
          "attempt": { "type": "integer", "minimum": 0 },
          "result_path": { "type": "string", "minLength": 1 },
          "idempotency_key": { "type": "string", "minLength": 1 },
          "occurred_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "lifecycle_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "status", "idempotency_key", "occurred_at"],
        "properties": {
          "event": { "enum": ["task.starting", "task.review-ready", "task.completed", "task.blocked", "task.cancelled"] },
          "status": { "enum": ["pending", "completed", "failed", "skipped", "manual"] },
          "idempotency_key": { "type": "string", "minLength": 1 },
          "occurred_at": { "type": "string", "format": "date-time" },
          "record": { "type": "string", "minLength": 1 },
          "actions": { "type": "array", "items": { "$ref": "activity-lifecycle-record.schema.json#/$defs/actionResult" } }
        }
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "source_kind": { "const": "plan" } }, "required": ["source_kind"] },
    "then": { "required": ["plan_work_items"] },
    "else": { "not": { "required": ["plan_work_items"] } }
  }, {
    "if": { "properties": { "contract_version": { "const": 1 } }, "required": ["contract_version"] },
    "then": { "properties": { "plan_work_items": { "maxItems": 1 } } }
  }, {
    "if": { "properties": { "contract_version": { "const": 3 } }, "required": ["contract_version"] },
    "then": { "required": ["plan_id", "plan_version", "plan_revision", "plan_verifier_input", "plan_verifier_status", "task_graph"] }
  }]
}
