{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaotypr.dev/kao-delivery-workspace/context-sync-request.schema.json",
  "title": "Context synchronization request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "author", "contributions", "proposals"],
  "properties": {
    "contract_version": { "const": 1 },
    "author": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "contributions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^contributions/(?:[a-z0-9]+(?:-[a-z0-9]+)*/)+[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+\\.md$" } },
    "proposals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/proposal" } }
  },
  "$defs": {
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_contribution", "classification", "summary"],
      "properties": {
        "source_contribution": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["durable-wrapper", "repository-local", "one-off", "future-task"] },
        "summary": { "type": "string", "minLength": 1 },
        "proposed_change": { "type": "string", "minLength": 1 },
        "target": { "enum": ["context/PROJECT.md", "context/ARCHITECTURE.md", "context/CONVENTIONS.md", "context/DECISIONS.md"] },
        "target_repository": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
      }
    }
  }
}
