{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/plan-publication-discovery.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "provider", "destination", "mappings"],
  "properties": {
    "contract_version": { "const": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "destination": { "type": "string", "minLength": 1 },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_id", "external_reference", "evidence"],
        "properties": {
          "work_id": { "type": "string", "minLength": 1 },
          "external_reference": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
