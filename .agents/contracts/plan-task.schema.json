{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/plan-task.schema.json",
  "title": "Authored numbered-plan task frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "plan_id", "repository", "parent_task", "depends_on", "connections"],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,15}-[0-9]{3,}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "parent_task": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "subtasks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "https://context-circuit.dev/schemas/plan-connection.schema.json"
      }
    }
  }
}
