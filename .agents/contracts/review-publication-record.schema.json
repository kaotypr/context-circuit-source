{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/review-publication-record.schema.json",
  "title": "Confirmed draft pull-request publication",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "work_id", "run_id", "repository", "status", "tool", "pull_request", "evidence", "head_commit", "idempotency_key", "recorded_at"],
  "properties": {
    "contract_version": { "const": 1 },
    "work_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "status": { "enum": ["published", "failed"] },
    "tool": { "enum": ["gh", "glab", "manual"] },
    "pull_request": { "type": ["string", "null"] },
    "evidence": { "type": "string", "minLength": 1 },
    "head_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "published" } } }, "then": { "properties": { "pull_request": { "type": "string", "minLength": 1 } } } },
    { "if": { "properties": { "status": { "const": "failed" } } }, "then": { "properties": { "pull_request": { "type": "null" } } } }
  ]
}
