{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/plan-publication-record.schema.json",
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_id", "title", "parent", "depends_on", "area", "repository", "action", "status", "external_reference", "evidence", "idempotency_key"],
      "properties": {
        "work_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "parent": { "type": ["string", "null"], "minLength": 1 },
        "depends_on": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "area": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "action": { "enum": ["create", "skip-existing"] },
        "status": { "enum": ["proposed", "existing", "created", "failed"] },
        "external_reference": { "type": ["string", "null"], "minLength": 1 },
        "evidence": { "type": ["string", "null"], "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "plan_id", "plan_version", "approved_digest", "provider", "destination", "status", "items", "warnings", "prepared_at", "updated_at"],
  "properties": {
    "contract_version": { "const": 2 },
    "plan_id": { "type": "string", "minLength": 1 },
    "plan_version": { "type": "integer", "minimum": 1 },
    "approved_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "provider": { "type": "string", "minLength": 1 },
    "destination": { "type": "string", "minLength": 1 },
    "status": { "enum": ["proposed", "in-progress", "partial", "completed", "failed"] },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "prepared_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
