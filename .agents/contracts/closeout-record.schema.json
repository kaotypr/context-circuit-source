{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/closeout-record.schema.json",
  "title": "Human-invoked run closeout record",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "work_id", "run_id", "repository", "outcome", "status", "author", "reason", "contribution", "branch", "base_commit", "head_commit", "merge_commit", "pull_requests", "commits", "changed_files", "verification", "cleanup", "blockers", "prepared_at", "updated_at"],
  "properties": {
    "contract_version": { "const": 1 },
    "work_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "outcome": { "enum": ["merged", "abandoned"] },
    "status": { "enum": ["prepared", "blocked", "closed"] },
    "author": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "reason": { "type": ["string", "null"], "minLength": 1 },
    "contribution": { "type": "string", "pattern": "^contributions/[a-z0-9]+(?:-[a-z0-9]+)*/[0-9]{8}T[0-9]{6}Z-[a-z0-9]+(?:-[a-z0-9]+)*-[a-z0-9]+(?:-[a-z0-9]+)*\\.md$" },
    "branch": { "type": "string", "minLength": 1 },
    "base_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "head_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "merge_commit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$" },
    "pull_requests": { "$ref": "#/$defs/strings" },
    "commits": { "$ref": "#/$defs/strings" },
    "changed_files": { "$ref": "#/$defs/strings" },
    "verification": { "$ref": "#/$defs/strings" },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "worktree_removed", "branch_preserved", "runtime_evidence_preserved"],
      "properties": {
        "requested": { "type": "boolean" },
        "worktree_removed": { "type": "boolean" },
        "branch_preserved": { "const": true },
        "runtime_evidence_preserved": { "const": true }
      }
    },
    "blockers": { "$ref": "#/$defs/strings" },
    "prepared_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "refresh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_ref", "before_commit", "refreshed_commit", "refreshed_at"],
      "properties": {
        "target_ref": { "type": "string", "minLength": 1 },
        "before_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "refreshed_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "refreshed_at": { "type": "string", "format": "date-time" }
      }
    },
    "product_knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impact", "synchronization"],
      "properties": {
        "impact": { "enum": ["absent", "matches-declared", "broader-than-declared", "contradicts-current", "not-reported"] },
        "synchronization": { "enum": ["not-required", "pending-review"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "abandoned" } } },
      "then": { "properties": { "reason": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "prepared" } } },
      "then": {
        "properties": {
          "cleanup": { "properties": { "worktree_removed": { "const": false } } },
          "blockers": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "blocked" } } },
      "then": {
        "properties": {
          "cleanup": { "properties": { "requested": { "const": true }, "worktree_removed": { "const": false } } },
          "blockers": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "closed" } } },
      "then": {
        "properties": {
          "cleanup": { "properties": { "requested": { "const": true }, "worktree_removed": { "const": true } } },
          "blockers": { "maxItems": 0 }
        }
      }
    }
  ]
}
