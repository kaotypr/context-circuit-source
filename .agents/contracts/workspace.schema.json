{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/workspace.schema.json",
  "title": "Workspace configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "template_version", "workspace", "repositories", "activity", "workflow"],
  "properties": {
    "version": { "const": 1 },
    "template_version": { "type": "string", "const": "0.2.1" },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mode", "default_branch"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["solo", "team"] },
        "default_branch": { "$ref": "#/$defs/gitRef" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 5000, "pattern": "\\S" },
        "remote": { "$ref": "#/$defs/safeReference" }
      }
    },
    "repositories": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/repository" }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "access", "required_capabilities", "optional_capabilities"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "access": { "enum": ["auto", "manual"] },
        "required_capabilities": { "$ref": "#/$defs/capabilities" },
        "optional_capabilities": { "$ref": "#/$defs/capabilities" },
        "lifecycle": {
          "type": "object",
          "propertyNames": { "enum": ["task.starting", "task.review-ready", "task.completed", "task.blocked", "task.cancelled"] },
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/activityAction" }
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_gates", "maximum_repair_attempts", "wrapper_change_policy"],
      "properties": {
        "human_gates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["plan-approval", "task-selection", "scope-expansion", "merge"] }
        },
        "maximum_repair_attempts": { "type": "integer", "minimum": 0, "maximum": 10 },
        "wrapper_change_policy": { "enum": ["pull-request", "direct-commit"] },
        "review_mode": { "enum": ["local", "remote"] }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoritative_sources"],
      "properties": {
        "authoritative_sources": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/contextSource" }
        }
      }
    },
    "product_knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirming_role"],
      "properties": {
        "confirming_role": { "$ref": "#/$defs/identifier" }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "gitRef": { "type": "string", "minLength": 1, "pattern": "^[^~^:?*[\\\\\\]\\s]+$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "safeReference": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^(?=.*\\S)[^\\r\\n]+$" },
    "contextSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "purpose"],
      "properties": {
        "kind": { "enum": ["prd", "architecture", "issue", "repository-documentation", "other"] },
        "reference": { "$ref": "#/$defs/safeReference" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
        "repository": { "$ref": "#/$defs/identifier" }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["read-tasks", "update-status", "create-tasks", "assign-task", "timers"] }
    },
    "activityAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability", "policy", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "capability": { "enum": ["read-tasks", "update-status", "create-tasks", "assign-task", "timers"] },
        "policy": { "enum": ["required", "optional", "manual"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "role", "agent", "default_branch"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "mode": { "enum": ["ignored-clone", "submodule"] },
        "role": { "type": "string", "minLength": 1 },
        "agent": { "$ref": "#/$defs/identifier" },
        "default_branch": { "$ref": "#/$defs/gitRef" },
        "remote": { "$ref": "#/$defs/safeReference" }
      }
    }
  }
}
