{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaotypr.dev/kao-delivery-workspace/fake-activity-source.schema.json",
  "title": "Deterministic read-only fake activity source",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "current_user", "candidates"],
  "properties": {
    "contract_version": { "const": 1 },
    "current_user": { "type": "string", "minLength": 1 },
    "candidates": {
      "type": "array",
      "items": { "$ref": "work-candidate.schema.json" }
    }
  }
}
