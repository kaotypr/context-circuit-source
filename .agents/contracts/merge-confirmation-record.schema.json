{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/merge-confirmation-record.schema.json",
  "title": "Verified human merge confirmation",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "work_id", "run_id", "repository", "status", "base_branch", "target_ref", "target_commit", "head_commit", "merge_commit", "evidence", "finish_work_argv", "finish_work_shell", "idempotency_key", "confirmed_at"],
  "properties": {
    "contract_version": { "const": 1 },
    "work_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "status": { "const": "closeout-ready" },
    "base_branch": { "type": "string", "minLength": 1 },
    "target_ref": { "type": "string", "minLength": 1 },
    "target_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "head_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "merge_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "evidence": { "type": "string", "minLength": 1 },
    "finish_work_argv": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "finish_work_shell": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "confirmed_at": { "type": "string", "format": "date-time" }
  }
}
