{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/context-sync-record.schema.json",
  "title": "Context synchronization record",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "sync_id", "status", "wrapper_mode", "base_branch", "base_commit", "branch", "worktree", "request", "allowed_wrapper_paths", "repository_follow_ups", "future_tasks", "retained_one_offs", "changed_files", "commits", "remote", "blockers", "prepared_at", "updated_at"],
  "properties": {
    "contract_version": { "const": 1 },
    "sync_id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$" },
    "status": { "enum": ["prepared", "review-ready", "blocked"] },
    "wrapper_mode": { "enum": ["pull-request", "direct-commit"] },
    "base_branch": { "type": "string", "minLength": 1 },
    "base_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "branch": { "type": "string", "minLength": 1 },
    "worktree": { "type": "string", "minLength": 1 },
    "request": { "type": "string", "minLength": 1 },
    "allowed_wrapper_paths": { "$ref": "#/$defs/strings" },
    "repository_follow_ups": { "type": "array", "items": { "$ref": "#/$defs/routed" } },
    "future_tasks": { "type": "array", "items": { "$ref": "#/$defs/future" } },
    "retained_one_offs": { "$ref": "#/$defs/strings" },
    "changed_files": { "$ref": "#/$defs/strings" },
    "commits": { "$ref": "#/$defs/strings" },
    "remote": { "type": ["string", "null"] },
    "blockers": { "$ref": "#/$defs/strings" },
    "prepared_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "routed": { "type": "object", "additionalProperties": false, "required": ["repository", "summary", "source_contribution"], "properties": { "repository": { "type": "string", "minLength": 1 }, "summary": { "type": "string", "minLength": 1 }, "source_contribution": { "type": "string", "minLength": 1 } } },
    "future": { "type": "object", "additionalProperties": false, "required": ["summary", "source_contribution"], "properties": { "summary": { "type": "string", "minLength": 1 }, "source_contribution": { "type": "string", "minLength": 1 } } }
  }
}
