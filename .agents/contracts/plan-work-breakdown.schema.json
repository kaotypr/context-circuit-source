{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/plan-work-breakdown.schema.json",
  "title": "Parsed plan work breakdown",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "plan_id", "work_prefix", "items"],
  "properties": {
    "contract_version": { "const": 2 },
    "plan_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "work_prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_id", "title", "parent", "depends_on", "area", "repository", "scope", "test_scope", "test_policy", "verification_commands", "acceptance_criteria", "external_reference"],
        "properties": {
          "work_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}-[0-9]{3,}$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "parent": { "type": ["string", "null"], "minLength": 1 },
          "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "area": { "type": "string", "minLength": 1 },
          "repository": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
          "test_scope": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
          "test_policy": { "enum": ["required", "existing-coverage", "verifier-only", "not-required"] },
          "test_rationale": { "type": "string", "minLength": 1 },
          "verification_commands": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "external_reference": { "type": ["string", "null"], "minLength": 1 },
          "subtasks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "connections": { "type": "array", "items": { "$ref": "#/$defs/connection" } }
        },
        "allOf": [{
          "if": { "properties": { "test_policy": { "enum": ["required", "existing-coverage"] } }, "required": ["test_policy"] },
          "then": { "properties": { "test_scope": { "minItems": 1 } } }
        }]
      }
    }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": { "enum": ["depends-on", "integrates-with", "blocks", "related", "supersedes"] },
        "target": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
