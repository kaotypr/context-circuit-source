{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/workspace-bootstrap-request.schema.json",
  "title": "Workspace bootstrap request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "configuration", "context", "wrapper", "repositories"],
  "properties": {
    "contract_version": { "const": 1 },
    "authorize_reviewable_changes": { "type": "boolean" },
    "configuration": { "$ref": "workspace.schema.json" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_summary", "architecture", "conventions", "decisions"],
      "properties": {
        "project_summary": { "type": "string", "minLength": 1, "maxLength": 5000, "pattern": "\\S" },
        "architecture": { "$ref": "#/$defs/notes" },
        "conventions": { "$ref": "#/$defs/notes" },
        "decisions": { "$ref": "#/$defs/notes" },
        "sources": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "workspace.schema.json#/$defs/contextSource" }
        },
        "product_knowledge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "purpose", "sources", "review_date", "roles", "domains", "unknowns"],
          "properties": {
            "title": { "$ref": "#/$defs/singleLine" },
            "purpose": { "type": "string", "minLength": 1, "maxLength": 5000, "pattern": "\\S" },
            "sources": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/singleLine" } },
            "review_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "roles": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/singleLine" } },
            "domains": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": { "$ref": "#/$defs/singleLine" },
                  "workflows": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/singleLine" } }
                }
              }
            },
            "unknowns": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/singleLine" } }
          }
        }
      }
    },
    "wrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialize_git", "authorize_initial_commit", "commit_message"],
      "properties": {
        "initialize_git": { "type": "boolean" },
        "authorize_initial_commit": { "type": "boolean" },
        "commit_message": { "$ref": "#/$defs/singleLine" },
        "author_name": { "$ref": "#/$defs/singleLine" },
        "author_email": { "type": "string", "format": "email", "maxLength": 254 }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "authorize_initial_commit"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "source": { "enum": ["new", "clone", "existing", "submodule"] },
          "url": { "$ref": "#/$defs/singleLine" },
          "authorize_initial_commit": { "type": "boolean" },
          "commit_message": { "$ref": "#/$defs/singleLine" },
          "author_name": { "$ref": "#/$defs/singleLine" },
          "author_email": { "type": "string", "format": "email", "maxLength": 254 }
        }
      }
    }
  },
  "$defs": {
    "singleLine": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?=.*\\S)[^\\r\\n]+$" },
    "notes": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/singleLine" }
    }
  }
}
