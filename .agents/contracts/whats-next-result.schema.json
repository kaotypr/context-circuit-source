{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/whats-next-result.schema.json",
  "title": "Read-only next-action recommendation",
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "candidate_id", "title", "why", "readiness_evidence", "source_references", "repositories", "agent_sequence", "blockers", "risks"],
      "properties": {
        "action": { "enum": ["execute", "review", "closeout", "reconcile", "enable"] },
        "candidate_id": { "type": ["string", "null"], "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "readiness_evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "source_references": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "repositories": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "agent_sequence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "risks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "generated_at", "recommendation", "alternatives", "considered", "warnings", "no_state_changed"],
  "properties": {
    "contract_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "recommendation": { "$ref": "#/$defs/action" },
    "alternatives": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/action" } },
    "considered": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "executable", "blocked", "excluded"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "executable": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "no_state_changed": { "const": true }
  }
}
