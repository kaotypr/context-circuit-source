{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaotypr.dev/kao-delivery-workspace/review-preparation.schema.json",
  "title": "Draft pull request preparation",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "work_id", "run_id", "repository", "status", "remote", "base_branch", "head_branch", "base_commit", "head_commit", "commits", "changed_files", "title", "body", "worker_result", "verifier_result", "blockers", "prepared_at"],
  "properties": {
    "contract_version": { "const": 1 },
    "work_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "status": { "enum": ["ready", "blocked"] },
    "remote": { "type": ["string", "null"], "minLength": 1 },
    "base_branch": { "type": "string", "minLength": 1 },
    "head_branch": { "type": "string", "minLength": 1 },
    "base_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "head_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "commits": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" } },
    "changed_files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "title": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 1 },
    "worker_result": { "type": "string", "minLength": 1 },
    "verifier_result": { "type": "string", "minLength": 1 },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "prepared_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ready" } } },
      "then": {
        "properties": {
          "remote": { "type": "string", "minLength": 1 },
          "blockers": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "blocked" } } },
      "then": { "properties": { "blockers": { "minItems": 1 } } }
    }
  ]
}
