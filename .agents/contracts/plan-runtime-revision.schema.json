{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/plan-runtime-revision.schema.json",
  "title": "Approved plan runtime revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "kind", "plan_reference", "plan_id", "run_id", "prior_plan_version", "prior_approved_digest", "plan_version", "approved_digest", "plan_revision", "reason", "changed_task_ids", "added_task_ids", "removed_task_ids", "invalidated_task_ids", "preserved_task_ids", "prior_manifest", "created_at"],
  "properties": {
    "contract_version": { "const": 1 },
    "kind": { "const": "approved-plan-runtime-revision" },
    "plan_reference": { "type": "string", "minLength": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "prior_plan_version": { "type": "integer", "minimum": 1 },
    "prior_approved_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "plan_version": { "type": "integer", "minimum": 1 },
    "approved_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "plan_revision": { "type": "integer", "minimum": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "changed_task_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "added_task_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "removed_task_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "invalidated_task_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "preserved_task_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "prior_manifest": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
