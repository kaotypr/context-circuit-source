{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/worker-result.schema.json",
  "title": "Repository worker result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "repository", "status", "summary", "branch", "worktree", "commits", "changed_files", "checks", "risks"],
  "properties": {
    "contract_version": { "enum": [1, 2] },
    "work_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "plan_reference": { "type": "string", "minLength": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "plan_version": { "type": "integer", "minimum": 1 },
    "task_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}-[0-9]{3,}$" },
    "plan_revision": { "type": "integer", "minimum": 1 },
    "approved_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "attempt": { "type": "integer", "minimum": 0 },
    "repository": { "type": "string", "minLength": 1 },
    "status": { "enum": ["completed", "blocked", "failed"] },
    "summary": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "worktree": { "type": "string", "minLength": 1 },
    "start_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "commits": { "$ref": "#/$defs/strings" },
    "changed_files": { "$ref": "#/$defs/strings" },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "risks": { "$ref": "#/$defs/strings" },
    "product_knowledge_impact": { "enum": ["absent", "matches-declared", "broader-than-declared", "contradicts-current"] }
  },
  "allOf": [
    { "if": { "properties": { "contract_version": { "const": 1 } }, "required": ["contract_version"] }, "then": { "required": ["work_id", "run_id"] } },
    { "if": { "properties": { "contract_version": { "const": 2 } }, "required": ["contract_version"] }, "then": { "required": ["run_id", "plan_reference", "plan_id", "plan_version", "task_id", "plan_revision", "approved_digest", "attempt", "repository", "branch", "worktree", "start_commit"] } }
  ],
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "status", "evidence"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "not-run"] },
        "evidence": { "type": "string" }
      }
    }
  }
}
