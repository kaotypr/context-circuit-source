{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-circuit.dev/schemas/plan-draft-request.schema.json",
  "title": "Plan draft creation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "plan_id", "title", "source", "work_prefix", "summary", "affected_repositories", "assumptions", "open_questions", "requirements", "solution", "delivery", "verification", "risks", "work_items"],
  "properties": {
    "contract_version": { "const": 1 },
    "plan_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": { "enum": ["idea", "prd", "document", "issue", "pull-request"] },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "work_prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}$" },
    "summary": { "type": "string", "minLength": 1 },
    "affected_repositories": { "$ref": "#/$defs/stringList" },
    "assumptions": { "$ref": "#/$defs/stringList" },
    "open_questions": { "$ref": "#/$defs/stringList" },
    "requirements": { "$ref": "#/$defs/nonEmptyStringList" },
    "solution": { "$ref": "#/$defs/nonEmptyStringList" },
    "delivery": { "$ref": "#/$defs/nonEmptyStringList" },
    "verification": { "$ref": "#/$defs/nonEmptyStringList" },
    "risks": { "$ref": "#/$defs/stringList" },
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "area", "repository", "scope", "test_scope", "test_policy", "verification_commands", "acceptance_criteria"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "area": { "type": "string", "minLength": 1 },
          "repository": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
          "test_scope": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
          "test_policy": { "enum": ["required", "existing-coverage", "verifier-only", "not-required"] },
          "test_rationale": { "type": "string", "minLength": 1 },
          "verification_commands": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "acceptance_criteria": { "$ref": "#/$defs/nonEmptyStringList" },
          "parent": { "type": "string", "minLength": 1 },
          "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "allOf": [{
          "if": { "properties": { "test_policy": { "enum": ["required", "existing-coverage"] } }, "required": ["test_policy"] },
          "then": { "properties": { "test_scope": { "minItems": 1 } } }
        }]
      }
    }
  },
  "$defs": {
    "stringList": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "nonEmptyStringList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" }
  }
}
