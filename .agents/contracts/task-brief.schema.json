{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaotypr.dev/kao-delivery-workspace/task-brief.schema.json",
  "title": "Normalized task brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "work_id", "run_id", "source", "requested_outcome", "scope", "acceptance_criteria", "repositories", "plan", "activity", "assumptions", "risks", "verification_commands", "authorization", "created_at"],
  "properties": {
    "contract_version": { "const": 1 },
    "work_id": { "type": "string", "pattern": "^(ADHOC-[0-9]{8}-[0-9]{3}|[A-Z][A-Z0-9]*-[0-9]+)$" },
    "run_id": { "$ref": "#/$defs/runId" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["direct-request", "plan", "issue", "pull-request", "activity-task"] },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "requested_outcome": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "implementation_scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "test_expectation": { "$ref": "#/$defs/testExpectation" },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "repositories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/repositoryTarget" } },
    "shared_contract": { "$ref": "#/$defs/sharedContract" },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "approval_state"],
      "properties": {
        "reference": { "type": ["string", "null"] },
        "approval_state": { "enum": ["not-applicable", "draft", "approved", "unknown"] }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "claim_status", "duplicate_effort_warning"],
      "properties": {
        "reference": { "type": ["string", "null"] },
        "claim_status": { "enum": ["not-applicable", "not-attempted", "claimed", "unavailable", "failed"] },
        "duplicate_effort_warning": { "type": "boolean" }
      }
    },
    "assumptions": { "$ref": "#/$defs/stringList" },
    "risks": { "$ref": "#/$defs/stringList" },
    "verification_commands": { "$ref": "#/$defs/stringList" },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "evidence"],
      "properties": {
        "kind": { "enum": ["explicit-user-request", "confirmed-selection"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "runId": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$" },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "testExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "paths", "rationale"],
      "properties": {
        "policy": { "enum": ["required", "existing-coverage", "verifier-only", "not-required"] },
        "paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "policy": { "enum": ["required", "existing-coverage"] } } },
          "then": { "properties": { "paths": { "minItems": 1 } } }
        }
      ]
    },
    "repositoryTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dependency_order"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "dependency_order": { "type": "integer", "minimum": 0 },
        "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
        "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "implementation_scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "test_expectation": { "$ref": "#/$defs/testExpectation" },
        "verification_commands": { "$ref": "#/$defs/stringList" },
        "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "sharedContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "paths"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
